    <DTS:Executable
      DTS:refId="Package\Transform and Move Data"
      DTS:CreationName="Microsoft.ExecuteSQLTask"
      DTS:Description="Execute SQL Task"
      DTS:DTSID="{253A9A31-B0D8-4B3B-ACAD-453BC62D9B21}"
      DTS:ExecutableType="Microsoft.ExecuteSQLTask"
      DTS:LocaleID="-1"
      DTS:ObjectName="Transform and Move Data"
      DTS:TaskContact="Execute SQL Task; Microsoft Corporation; SQL Server 2025; © 2025 Microsoft Corporation; All Rights Reserved;http://www.microsoft.com/sql/support/default.asp;1"
      DTS:ThreadHint="0">
      <DTS:Variables />
      <DTS:ObjectData>
        <SQLTask:SqlTaskData
          SQLTask:Connection="{A13F5C91-B706-4BCD-9B68-98AC3A9E75DF}"
          SQLTask:SqlStatementSource="USE TimesheetDB;&#xA;GO&#xA;&#xA;-- ==========================================&#xA;-- PRE-EXECUTION: DECLARE TRACKING VARIABLES&#xA;-- ==========================================&#xA;DECLARE @CurrentAuditID INT;&#xA;DECLARE @TSInserted INT = 0;&#xA;DECLARE @TSUpdated INT = 0;&#xA;DECLARE @TSDeleted INT = 0;&#xA;DECLARE @LeaveInserted INT = 0;&#xA;&#xA;-- Temporary table variable to capture detailed MERGE action metrics&#xA;DECLARE @ActionTracker TABLE (ActionType VARCHAR(20));&#xA;&#xA;-- ==========================================&#xA;-- STEP 1: INITIALIZE THE AUDIT LOG ROW&#xA;-- ==========================================&#xA;INSERT INTO AuditLog (&#xA;    PackageName, &#xA;    TaskName, &#xA;    InsertsProcessed,&#xA;    UpdatesProcessed,&#xA;    DeletesProcessed,&#xA;    Status, &#xA;    [Message], &#xA;    LogTimestamp&#xA;)&#xA;VALUES (&#xA;    'GraduateTimesheet_ETL', &#xA;    'Clean and Normalize Core Tables', &#xA;    0, 0, 0,&#xA;    'Running', &#xA;    'Execution initialized.', &#xA;    GETDATE()&#xA;);&#xA;&#xA;SET @CurrentAuditID = SCOPE_IDENTITY(); &#xA;&#xA;-- Start safety transaction wrapper&#xA;BEGIN TRANSACTION;&#xA;BEGIN TRY&#xA;&#xA;    -- ==========================================&#xA;    -- STEP 2: POPULATE EMPLOYEE DIMENSION (Delta Only)&#xA;    -- ==========================================&#xA;    INSERT INTO Employee (Name)&#xA;    SELECT DISTINCT EmployeeName&#xA;    FROM StagingTimesheet&#xA;    WHERE EmployeeName IS NOT NULL &#xA;      AND EmployeeName &lt;&gt; ''&#xA;      AND NOT EXISTS (&#xA;          SELECT 1 FROM Employee e &#xA;          WHERE e.Name = StagingTimesheet.EmployeeName&#xA;      );&#xA;&#xA;    -- ==========================================&#xA;    -- STEP 3: POPULATE CLIENT DIMENSION (Delta Only)&#xA;    -- ==========================================&#xA;    INSERT INTO Client (ClientName)&#xA;    SELECT DISTINCT ISNULL(NULLIF(LTRIM(RTRIM(RawClient)), ''), 'Internal')&#xA;    FROM StagingTimesheet&#xA;    WHERE RawClient IS NOT NULL &#xA;      AND RawClient &lt;&gt; ''&#xA;      AND NOT EXISTS (&#xA;          SELECT 1 FROM Client c &#xA;          WHERE c.ClientName = ISNULL(NULLIF(LTRIM(RTRIM(StagingTimesheet.RawClient)), ''), 'Internal')&#xA;      );&#xA;&#xA;    -- ==========================================&#xA;    -- STEP 4: LOAD FACT LEAVE TABLE (Delta Only)&#xA;    -- ==========================================&#xA;    INSERT INTO Leave (&#xA;        EmployeeName, &#xA;        LeaveDate, &#xA;        LeaveType, &#xA;        TotalHours, &#xA;        AuditID&#xA;    )&#xA;    SELECT &#xA;        st.EmployeeName,&#xA;        TRY_CAST(st.RawDate AS DATE) AS LeaveDate,&#xA;        ISNULL(NULLIF(LTRIM(RTRIM(st.RawDescription)), ''), ISNULL(NULLIF(LTRIM(RTRIM(st.RawClient)), ''), 'General Leave')) AS LeaveType,&#xA;        CASE &#xA;            WHEN CHARINDEX(':', LTRIM(RTRIM(st.RawTotalHours))) &gt; 0 THEN LEFT(LTRIM(RTRIM(st.RawTotalHours)), 5)&#xA;            ELSE '00:00'&#xA;        END AS TotalHours,&#xA;        @CurrentAuditID AS AuditID&#xA;    FROM StagingTimesheet st&#xA;    WHERE st.RawDate IS NOT NULL &#xA;      AND TRY_CAST(st.RawDate AS DATE) IS NOT NULL&#xA;      AND (LOWER(ISNULL(st.RawDescription, '')) LIKE '%leave%' OR LOWER(ISNULL(st.RawClient, '')) LIKE '%leave%')&#xA;      AND DATEPART(dw, TRY_CAST(st.RawDate AS DATE)) NOT IN (1, 7)&#xA;      AND LOWER(ISNULL(st.RawDescription, '')) &lt;&gt; 'public holiday'&#xA;      AND NOT EXISTS (&#xA;          SELECT 1 FROM Leave l&#xA;          WHERE l.EmployeeName = st.EmployeeName&#xA;            AND l.LeaveDate = TRY_CAST(st.RawDate AS DATE)&#xA;            AND l.LeaveType = ISNULL(NULLIF(LTRIM(RTRIM(st.RawDescription)), ''), ISNULL(NULLIF(LTRIM(RTRIM(st.RawClient)), ''), 'General Leave'))&#xA;      );&#xA;&#xA;    SET @LeaveInserted = @@ROWCOUNT;&#xA;&#xA;    -- ==========================================&#xA;    -- STEP 5: MERGE FACT TIMESHEET (Filter Out Empty Fluff Rows)&#xA;    -- ==========================================&#xA;    MERGE dbo.Timesheet AS target&#xA;    USING (&#xA;        SELECT &#xA;            e.EmployeeID,&#xA;            st.EmployeeName,&#xA;            ISNULL(NULLIF(LTRIM(RTRIM(st.RawClient)), ''), 'Internal') AS Client,&#xA;            TRY_CAST(st.RawDate AS DATE) AS WorkDate,&#xA;            ISNULL(NULLIF(LTRIM(RTRIM(st.RawDayOfWeek)), ''), DATENAME(weekday, TRY_CAST(st.RawDate AS DATE))) AS DayOfWeek,&#xA;            ISNULL(NULLIF(LTRIM(RTRIM(st.RawBillableStatus)), ''), 'Non-Billable') AS BillableStatus,&#xA;            TRY_CAST(st.RawStartTime AS TIME) AS StartTime,&#xA;            TRY_CAST(st.RawEndTime AS TIME) AS EndTime,&#xA;            CASE &#xA;                WHEN CHARINDEX(':', LTRIM(RTRIM(st.RawTotalHours))) &gt; 0 THEN LEFT(LTRIM(RTRIM(st.RawTotalHours)), 5)&#xA;                ELSE '00:00'&#xA;            END AS TotalHours,&#xA;            ISNULL(NULLIF(LTRIM(RTRIM(st.RawDescription)), ''), 'No description provided') AS TaskDescription,&#xA;            ISNULL(NULLIF(LTRIM(RTRIM(st.RawComments)), ''), 'None') AS Comments&#xA;        FROM dbo.StagingTimesheet st&#xA;        INNER JOIN dbo.Employee e ON e.Name = st.EmployeeName&#xA;        WHERE st.RawDate IS NOT NULL&#xA;          AND TRY_CAST(st.RawDate AS DATE) IS NOT NULL&#xA;          AND LOWER(ISNULL(st.RawDescription, '')) NOT LIKE '%leave%' &#xA;          AND LOWER(ISNULL(st.RawClient, '')) NOT LIKE '%leave%'&#xA;          AND DATEPART(dw, TRY_CAST(st.RawDate AS DATE)) NOT IN (1, 7)&#xA;          AND LOWER(ISNULL(st.RawDescription, '')) &lt;&gt; 'public holiday'&#xA;          &#xA;          -- NEW FILTER: Completely drops rows that are essentially empty&#xA;          AND LTRIM(RTRIM(ISNULL(st.RawStartTime, ''))) &lt;&gt; ''&#xA;          AND LTRIM(RTRIM(ISNULL(st.RawEndTime, ''))) &lt;&gt; ''&#xA;          AND LTRIM(RTRIM(ISNULL(st.RawDescription, ''))) &lt;&gt; ''&#xA;    ) AS source&#xA;    ON (target.EmployeeID = source.EmployeeID &#xA;        AND target.WorkDate = source.WorkDate&#xA;        AND target.StartTime = source.StartTime)&#xA;&#xA;    -- Condition A: Row exists but fields changed ➔ UPDATE&#xA;    WHEN MATCHED AND (&#xA;        target.TotalHours &lt;&gt; source.TotalHours &#xA;        OR target.EndTime &lt;&gt; source.EndTime &#xA;        OR target.TaskDescription &lt;&gt; source.TaskDescription&#xA;        OR target.BillableStatus &lt;&gt; source.BillableStatus&#xA;        OR target.Client &lt;&gt; source.Client&#xA;        OR target.Comments &lt;&gt; source.Comments&#xA;        OR target.DayOfWeek &lt;&gt; source.DayOfWeek&#xA;    ) THEN&#xA;        UPDATE SET &#xA;            target.Client = source.Client,&#xA;            target.EndTime = source.EndTime,&#xA;            target.TotalHours = source.TotalHours,&#xA;            target.TaskDescription = source.TaskDescription,&#xA;            target.Comments = source.Comments,&#xA;            target.BillableStatus = source.BillableStatus,&#xA;            target.DayOfWeek = source.DayOfWeek,&#xA;            target.AuditID = @CurrentAuditID&#xA;&#xA;    -- Condition B: Row does not exist ➔ INSERT&#xA;    WHEN NOT MATCHED BY TARGET THEN&#xA;        INSERT (EmployeeID, EmployeeName, Client, WorkDate, DayOfWeek, BillableStatus, StartTime, EndTime, TotalHours, TaskDescription, Comments, AuditID)&#xA;        VALUES (source.EmployeeID, source.EmployeeName, source.Client, source.WorkDate, source.DayOfWeek, source.BillableStatus, source.StartTime, source.EndTime, source.TotalHours, source.TaskDescription, source.Comments, @CurrentAuditID)&#xA;&#xA;    OUTPUT $action INTO @ActionTracker;&#xA;&#xA;    -- Aggregate counts from the memory tracker variable&#xA;    SELECT @TSInserted = COUNT(*) FROM @ActionTracker WHERE ActionType = 'INSERT';&#xA;    SELECT @TSUpdated = COUNT(*) FROM @ActionTracker WHERE ActionType = 'UPDATE';&#xA;&#xA;    -- ==========================================&#xA;    -- STEP 6: PROCESS DELETIONS / LOGICAL REMOVALS&#xA;    -- ==========================================&#xA;    DELETE t&#xA;    FROM dbo.Timesheet t&#xA;    INNER JOIN dbo.StagingTimesheet st ON st.RawDate = CAST(t.WorkDate AS NVARCHAR(50))&#xA;    INNER JOIN dbo.Employee e ON e.EmployeeID = t.EmployeeID AND e.Name = st.EmployeeName&#xA;    WHERE (st.RawTotalHours = '00:00' OR st.RawTotalHours = '0' OR st.RawTotalHours IS NULL)&#xA;      AND t.WorkDate = TRY_CAST(st.RawDate AS DATE)&#xA;      AND t.StartTime = TRY_CAST(st.RawStartTime AS TIME);&#xA;&#xA;    SET @TSDeleted = @@ROWCOUNT;&#xA;&#xA;    -- Commit transaction if everything passes cleanly&#xA;    COMMIT TRANSACTION;&#xA;&#xA;    -- ==========================================&#xA;    -- STEP 7: FINALIZE OPERATIONAL AUDIT LOG (Success)&#xA;    -- ==========================================&#xA;    UPDATE AuditLog&#xA;    SET &#xA;        InsertsProcessed = (@TSInserted + @LeaveInserted),&#xA;        UpdatesProcessed = @TSUpdated,&#xA;        DeletesProcessed = @TSDeleted,&#xA;        Status = 'Success',&#xA;        [Message] = 'ETL Complete. Synced ' + CAST(@TSInserted AS VARCHAR(5)) + ' work entries, ' + CAST(@LeaveInserted AS VARCHAR(5)) + ' leave entries. Updated: ' + CAST(@TSUpdated AS VARCHAR(5)) + '. Deleted: ' + CAST(@TSDeleted AS VARCHAR(5)) + '.',&#xA;        LogTimestamp = GETDATE()&#xA;    WHERE AuditID = @CurrentAuditID;&#xA;&#xA;END TRY&#xA;BEGIN CATCH&#xA;    -- Rollback active transaction if an unhandled schema or data error strikes&#xA;    IF @@TRANCOUNT &gt; 0 ROLLBACK TRANSACTION;&#xA;&#xA;    -- Update log metadata to capture the failure break details&#xA;    UPDATE AuditLog&#xA;    SET &#xA;        Status = 'Failure',&#xA;        [Message] = 'ERROR DETECTED: ' + ERROR_MESSAGE(),&#xA;        LogTimestamp = GETDATE()&#xA;    WHERE AuditID = @CurrentAuditID;&#xA;&#xA;    -- Rethrow the error upward so the SSIS component turns red&#xA;    THROW;&#xA;END CATCH;&#xA;&#xA;" xmlns:SQLTask="www.microsoft.com/sqlserver/dts/tasks/sqltask" />
      </DTS:ObjectData>
    </DTS:Executable>
  </DTS:Executables>
